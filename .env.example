# Kiln Watch Email & Alert Configuration

# 1. Base URL for confirmation and unsubscribe links in emails
# For local development with Vite:
PUBLIC_URL=http://localhost:5174
# For production deployment:
# PUBLIC_URL=https://your-domain.com

# 2. SMTP Server Configuration
# -------------------------------------------------------------
# Option A: Gmail (Quickest for personal/dev testing)
# Step 1: Turn on 2-Step Verification in your Google Account
# Step 2: Generate an "App Password" at: https://myaccount.google.com/apppasswords
# Step 3: Fill in your address and the 16-character password below:
# -------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=Kiln Watch Alerts <your_email@gmail.com>

# -------------------------------------------------------------
# Option B: Brevo / SendGrid / Resend / Mailgun (Transactional)
# -------------------------------------------------------------
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-login
# SMTP_PASSWORD=your-smtp-key
# SMTP_FROM=Kiln Watch Alerts <alerts@yourdomain.com>

# 3. Alert Delivery Loop Interval (hours, defaults to 3)
ALERT_INTERVAL_H=3

