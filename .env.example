# Kiln Watch Email & Alert Configuration

# 1. Base URL for confirmation and unsubscribe links in emails
# On localhost the link automatically uses whatever port the site is open on (5173, 5174, ...), so nothing to set.
# For production deployment (the live domain; also the fallback when the browser sends no origin):
# PUBLIC_URL=https://your-domain.com
# Extra live domains allowed to receive links (comma separated, e.g. a custom domain next to the vercel.app one):
# ALLOWED_ORIGINS=https://www.your-domain.com

# 2. SMTP Server Configuration
# -------------------------------------------------------------
# Option A: Gmail (Quickest for personal/dev testing)
# Step 1: Turn on 2-Step Verification in your Google Account
# Step 2: Generate an "App Password" at: https://myaccount.google.com/apppasswords
# Step 3: Fill in your address and the 16-character password below:
# -------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=Kiln Watch Alerts <your_email@gmail.com>

# -------------------------------------------------------------
# Option B: Brevo / SendGrid / Resend / Mailgun (Transactional)
# -------------------------------------------------------------
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-login
# SMTP_PASSWORD=your-smtp-key
# SMTP_FROM=Kiln Watch Alerts <alerts@yourdomain.com>

# Contact form: comma-separated addresses that receive site messages (needs the SMTP settings above).
# Without it, messages are only stored in data/feedback.jsonl on the server.
# CONTACT_EMAILS=team@example.org,lead@example.org

# Gemini analyst (optional; free keys at https://aistudio.google.com/apikey). Never commit real keys: this repo is public.
# The main key is tried first; on a quota error (429), overload (503) or refusal (401/403) the next key is used.
# GEMINI_API_KEY=your-main-key
# GEMINI_API_KEYS=fallback-key-1,fallback-key-2,fallback-key-3
# GEMINI_MODEL=gemini-flash-latest

# 3. Alert Delivery Loop Interval (hours, defaults to 3)
ALERT_INTERVAL_H=3

